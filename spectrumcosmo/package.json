{
  "name": "spectrumcosmo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next build && next export",
    "cap:init": "npx cap init SpectrumCosmo com.spectrumcosmo.app --web-dir=out",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:sync:android": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "build:android": "npm run build && npm run cap:sync:android && npm run cap:open:android",
    "build:ios": "npm run build && npm run cap:sync:ios && npm run cap:open:ios"
  },
